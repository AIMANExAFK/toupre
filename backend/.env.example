# ─── LocaShare backend ─────────────────────────────────
# Copie ce fichier en `.env` et remplis les valeurs.
# Ne JAMAIS commiter le `.env` réel (déjà dans .gitignore).

# MongoDB
# Option A — Local : installer via `brew install mongodb-community` puis `brew services start mongodb-community`
#   MONGO_URL=mongodb://localhost:27017
# Option B — Atlas (gratuit) : https://cloud.mongodb.com → créer un cluster gratuit → copier l'URI
MONGO_URL=mongodb://localhost:27017
DB_NAME=locashare

# JWT — génère un secret fort : `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Stripe — https://dashboard.stripe.com/test/apikeys
# Utilise la clé "Secret key" en mode TEST (commence par sk_test_)
STRIPE_API_KEY=sk_test_CHANGE_ME

# Optionnel — URL du frontend pour les redirects Stripe
FRONTEND_URL=http://localhost:4174

# Local/dev
LOCASHARE_REQUIRE_KYC=true
LOCASHARE_AUTO_VERIFY_KYC=true
LOCASHARE_ENABLE_LOCAL_PAYMENTS=true

# Envoi OTP par email — passerelle SMTP Resend (resend.com)
# Mode test : envois limités à l'adresse du compte Resend. Pour envoyer à tous :
# vérifier un domaine sur resend.com/domains puis remplacer SMTP_FROM par ce domaine.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_VOTRE_CLE_API
SMTP_FROM="LocaShare <onboarding@resend.dev>"
